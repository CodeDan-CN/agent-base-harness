{
  "name": "agent-base-harness",
  "version": "0.1.0",
  "private": true,
  "description": "Agent Harness server and remote Web/Desktop/CLI clients",
  "main": "dist/main/index.cjs",
  "bin": {
    "agent-harness": "dist/cli/index.cjs"
  },
  "files": [
    "dist/server/**/*",
    "dist/cli/**/*",
    "dist/client/**/*",
    "dist/web/**/*",
    "resources/model-catalog.json",
    "resources/runtime-lock.json"
  ],
  "type": "commonjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:server && npm run build:cli && npm run build:desktop",
    "build:server": "node scripts/build.mjs server && node scripts/build.mjs admin && npm run build:client && npm run build:web",
    "build:client": "node scripts/build.mjs client",
    "build:cli": "node scripts/build.mjs cli",
    "pack:cli": "npm run build:cli && node scripts/prepare-cli-package.mjs && npm pack ./release/cli/package --pack-destination release/cli",
    "verify:remote": "node scripts/verify-remote-clients.mjs",
    "verify:desktop-package": "node scripts/verify-desktop-package.mjs",
    "build:main": "node scripts/build.mjs main",
    "build:preload": "node scripts/build.mjs preload",
    "build:worker": "node scripts/build.mjs worker",
    "build:renderer": "npm run check:ui-boundary && vite build",
    "build:web": "npm run check:ui-boundary && vite build --config vite.web.config.ts",
    "service:prepare": "npm run rebuild:node && node scripts/prepare-service-runtime.mjs",
    "pack:server": "npm run build:server && node scripts/prepare-server-package.mjs && npm pack ./build-support/server-package --pack-destination release/server && npm run verify:server-package",
    "verify:server-package": "node scripts/verify-server-package.mjs",
    "pack:runtime:macos": "node scripts/pack-runtime.mjs --target darwin-arm64",
    "verify:runtime:macos": "node build-support/verify-platform-runtime.mjs --target darwin-arm64",
    "start": "node dist/server/index.cjs",
    "start:web": "npm run start",
    "typecheck": "npm run check:boundaries && tsc --noEmit && tsc --noEmit -p tsconfig.ui.json",
    "check:ui-boundary": "node scripts/check-ui-boundary.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "runtime:prepare": "node build-support/prepare-runtime-pack.mjs",
    "runtime:verify": "node build-support/verify-runtime-pack.mjs",
    "pack:sign-local": "codesign --force --deep --sign - \"release/mac-arm64/Agent Harness.app\" && codesign --verify --deep --strict \"release/mac-arm64/Agent Harness.app\"",
    "catalog:build": "node scripts/build-model-catalog.mjs",
    "benchmark:travel": "npm run build:worker && electron scripts/agent-travel-benchmark.mjs",
    "benchmark:travel:compare": "node scripts/generate-travel-agent-comparison.mjs",
    "test": "npm run rebuild:node && vitest run",
    "test:unit": "npm run rebuild:node && vitest run tests/unit",
    "test:integration": "npm run rebuild:node && vitest run tests/integration",
    "test:contract": "npm run rebuild:node && vitest run tests/contract",
    "test:security": "npm run rebuild:node && vitest run tests/security",
    "test:watch": "npm run rebuild:node && vitest",
    "e2e": "npm run build && npm run verify:remote",
    "pack": "npm run pack:desktop",
    "dist": "npm run build:desktop && electron-builder",
    "rebuild": "npm run rebuild:electron",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "rebuild:node": "node scripts/rebuild-native.mjs",
    "dev:server": "node scripts/dev.mjs server",
    "dev:runtime": "npm run dev:server",
    "dev:web": "vite --config vite.web.config.ts",
    "dev:mobile": "vite --config vite.mobile.config.ts",
    "build:mobile": "npm run check:boundaries && vite build --config vite.mobile.config.ts",
    "pack:mobile": "npm run build:mobile && node scripts/pack-mobile.mjs",
    "verify:mobile": "node scripts/verify-mobile-policy.mjs && vitest run tests/unit/mobile-transport.test.ts && node scripts/verify-mobile.mjs",
    "dev:desktop": "node scripts/dev.mjs desktop",
    "dev:client": "npm run dev:desktop",
    "start:desktop": "electron .",
    "build:desktop": "npm run build:main && npm run build:preload && npm run build:renderer",
    "pack:desktop": "npm run build:desktop && electron-builder --dir",
    "check:boundaries": "node scripts/check-workspace-boundaries.mjs",
    "pack:runtime": "node scripts/pack-runtime.mjs",
    "pack:runtime:linux": "node scripts/pack-runtime.mjs --target linux-x64",
    "verify:runtime:linux": "node build-support/verify-platform-runtime.mjs --target linux-x64",
    "pack:ubuntu": "bash deployment/ubuntu24.04/package.sh",
    "pack:ubuntu22": "bash deployment/ubuntu22.04/package.sh",
    "deploy:ubuntu22": "bash deployment/ubuntu22.04/deploy.sh",
    "deploy:ubuntu": "bash deployment/ubuntu24.04/deploy.sh",
    "pack:centos": "bash deployment/centos/package.sh",
    "deploy:centos": "bash deployment/centos/deploy.sh",
    "pack:runtime:deb": "bash deployment/ubuntu24.04/package-runtime-deb.sh",
    "install:runtime": "npm ci --workspace apps/server --workspace apps/web --workspace apps/cli --workspace packages --include-workspace-root --no-audit --no-fund",
    "typecheck:runtime": "npm run check:boundaries && tsc --noEmit -p tsconfig.runtime.json"
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@playwright/test": "^1.62.1",
    "@types/archiver": "^8.0.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^4.3.4",
    "archiver": "^8.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.20.0",
    "lucide-react": "^0.546.0",
    "playwright": "^1.50.1",
    "prettier": "^3.4.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.24.0",
    "vite": "^6.2.0",
    "vitest": "^3.0.5"
  },
  "overrides": {
    "@electron/node-gyp": "10.2.0-electron.2"
  },
  "build": {
    "electronDist": "node_modules/electron/dist",
    "appId": "com.agentharness.client",
    "productName": "Agent Harness",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/main/**/*",
      "dist/preload/**/*",
      "dist/renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      }
    ],
    "npmRebuild": false,
    "mac": {
      "icon": "resources/icon.icns",
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg"
      ]
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "workspaces": [
    "packages/test-kit",
    "apps/server",
    "apps/web",
    "apps/desktop",
    "apps/cli",
    "apps/mobile",
    "packages/protocol",
    "packages/client-sdk",
    "packages/app-ui",
    "packages/storage",
    "packages/execution",
    "packages/runtime-core",
    "packages/server-core"
  ]
}
