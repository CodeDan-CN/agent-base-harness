{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@client-contracts": ["packages/protocol/src/client/index.ts"],
      "@ui/*": ["packages/app-ui/src/*"]
    }
  },
  "include": [
    "packages/app-ui/src",
    "apps/web/src",
    "apps/mobile/src",
    "apps/desktop/src/renderer",
    "packages/protocol/src/client"
  ],
  "exclude": ["node_modules", "dist", "dist-*", "out", "reference_ui", "tests"]
}
